rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function inFirm(firmId) {
      return request.auth != null && request.auth.token.firmId == firmId;
    }

    match /firms/{firmId}/documents/{documentId} {
      allow read: if inFirm(firmId);
      allow create, update: if inFirm(firmId)
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*|application/vnd.openxmlformats-officedocument.wordprocessingml.document|application/msword|application/vnd.openxmlformats-officedocument.spreadsheetml.sheet|application/vnd.ms-excel');
      allow delete: if inFirm(firmId);
    }
  }
}
